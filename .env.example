APP_NAME=Tulisin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Domain yang boleh memakai auth cookie Sanctum (SPA). Pisahkan dengan koma.
# Local: localhost:8000 / 127.0.0.1:8000. Produksi: domain-anda.com,www.domain-anda.com
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Origin cross-origin yang diizinkan (kosongkan untuk SPA di domain yang sama).
# Contoh frontend terpisah: CORS_ALLOWED_ORIGINS=https://app.domain.com
CORS_ALLOWED_ORIGINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Pembayaran (SumoPod QRIS) ----
PAYMENT_PROVIDER=sumopod
PAYMENT_FEE_FIXED=2000
PAYMENT_FEE_PERCENT=0
PAYMENT_CURRENCY=IDR
PAYMENT_EXPIRES_HOURS=24

SUMOPOD_SANDBOX=true
SUMOPOD_SANDBOX_BASE_URL=https://api-pay-sandbox.sumopod.com
SUMOPOD_LIVE_BASE_URL=https://api-pay.sumopod.com
SUMOPOD_SANDBOX_API_KEY=
SUMOPOD_LIVE_API_KEY=

# Verifikasi webhook — isi SALAH SATU:
# 1) Signature Svix-style (prefix whsec_)
SUMOPOD_WEBHOOK_SECRET=
# 2) Token statis (header X-Webhook-Token, prefix whtok_)
SUMOPOD_WEBHOOK_TOKEN=

# URL redirect setelah bayar/batal. Kosongkan untuk memakai halaman bawaan
# aplikasi (/payment/success dan /payment/failed). Isi hanya bila perlu URL lain.
PAYMENT_SUCCESS_RETURN_URL=
PAYMENT_CANCEL_RETURN_URL=
